Windows Registry Editor Version 5.00

; ==============================================================================
; F.R.O.S.T. - System-Wide Incognito Mode Elimination Policy
; Disables Incognito / InPrivate mode across Chrome, Edge, and Brave
; ==============================================================================

; Google Chrome (Machine & User Level)
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"IncognitoModeAvailability"=dword:00000001

[HKEY_CURRENT_USER\SOFTWARE\Policies\Google\Chrome]
"IncognitoModeAvailability"=dword:00000001

; Microsoft Edge (Machine & User Level)
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"InPrivateModeAvailability"=dword:00000001

[HKEY_CURRENT_USER\SOFTWARE\Policies\Microsoft\Edge]
"InPrivateModeAvailability"=dword:00000001

; Brave Browser (Machine & User Level)
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\BraveSoftware\Brave]
"IncognitoModeAvailability"=dword:00000001

[HKEY_CURRENT_USER\SOFTWARE\Policies\BraveSoftware\Brave]
"IncognitoModeAvailability"=dword:00000001

